{
  "state_file": "state.json",
  "triggers": [
    {
      "name": "low_soc",
      "json_path": ".data.soc",
      "param_name": "soc",
      "operator": "<",
      "threshold": 10.0,
      "required_seconds": 1500
    },
    {
      "name": "high_load",
      "json_path": ".data.pload",
      "param_name": "pload",
      "operator": ">",
      "threshold": 500.0,
      "required_seconds": 120
    },
    {
      "name": "full_soc",
      "json_path": ".data.soc",
      "param_name": "soc",
      "operator": "==",
      "threshold": 100.0,
      "required_seconds": 300
    },
    {
      "name": "low_ppv",
      "json_path": ".data.ppv",
      "param_name": "ppv",
      "operator": "<",
      "threshold": 1000,
      "required_seconds": 300
    }
  ]
}
